pageType: content
background:
  type: solid
  color: "$primary"
elements:
  - elementId: feat-title
    elementType: text
    bounds: [60, 40, 700, 40]
    content:
      style: "$heading"
      align: [left, middle]
      wrap: false
      text: |
        <p>核心功能总览</p>

  - elementId: feat-line
    elementType: shape
    bounds: [60, 88, 1160, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 1, color: "$border"}

  - elementId: feat-card1-bg
    elementType: shape
    bounds: [60, 110, 370, 100]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "$card_bg"}
    border: {style: solid, width: 1, color: "$border"}

  - elementId: feat-card1-icon
    elementType: icon
    bounds: [80, 130, 28, 28]
    iconName: "fas:microphone"
    fill: {type: solid, color: "$accent"}

  - elementId: feat-card1-title
    elementType: text
    bounds: [118, 125, 290, 28]
    content:
      fontSize: 17
      color: "$text"
      fontFamily: "Liter, alimamashuheiti"
      align: [left, middle]
      wrap: false
      text: |
        <p>实时语音转录</p>

  - elementId: feat-card1-desc
    elementType: text
    bounds: [118, 158, 290, 40]
    content:
      fontSize: 13
      color: "$text_secondary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.4
      align: [left, top]
      text: |
        <p>FunASR 本地模型 + 云端降级，流式实时转录</p>

