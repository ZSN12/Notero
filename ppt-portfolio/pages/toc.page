pageType: table_of_contents
background:
  type: solid
  color: "$primary"
elements:
  - elementId: toc-label
    elementType: text
    bounds: [60, 180, 400, 50]
    content:
      fontSize: 42
      color: "$text_secondary"
      fontFamily: "Liter, alimamashuheiti"
      align: [left, middle]
      wrap: false
      letterSpacing: 4
      text: |
        <p>CONTENTS</p>

  - elementId: toc-line
    elementType: shape
    bounds: [60, 250, 80, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 3, color: "$accent"}

