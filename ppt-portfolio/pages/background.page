      text: |
        <p>零散笔记缺乏结构化知识梳理，复习时难以建立知识体系</p>

  - elementId: bg-card4
    elementType: shape
    bounds: [660, 260, 560, 130]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "$card_bg"}
